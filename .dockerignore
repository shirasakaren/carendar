# The two Dockerfiles are built from the repository root
# (docker build -f apps/<app>/Dockerfile .), so this single file governs
# both build contexts.

# Git & editors
.git
.gitignore
.DS_Store
.idea/
.vscode/

# Node / Next.js
**/node_modules
**/.next
**/out
**/*.tsbuildinfo
next-env.d.ts

# Env & secrets
**/.env
**/.env.*
!**/.env.example

# Go build artifacts
**/*.test
**/*.out
**/coverage.*

# Docs & tooling not needed inside images
*.md
!README.md
.github/
Makefile
CHANGELOG.md
CONTRIBUTING.md
SECURITY.md
CODEOWNERS
docker-compose.yml
