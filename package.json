{
  "name": "carendar",
  "version": "0.4.0",
  "private": true,
  "description": "Carendar — public event calendar and admin panel, shipped as one monorepo (Next.js frontend + Go backend).",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @carendar/frontend",
    "build": "npm run build --workspace @carendar/frontend",
    "start": "npm run start --workspace @carendar/frontend",
    "lint": "npm run lint --workspace @carendar/frontend",
    "typecheck": "npm run typecheck --workspace @carendar/frontend",
    "build:go": "cd apps/backend && go build ./...",
    "test:go": "cd apps/backend && go test -race -timeout 5m ./...",
    "vet:go": "cd apps/backend && go vet ./..."
  },
  "engines": {
    "node": ">=20"
  }
}
